APP_NAME=Kovidam AI Interview API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kovidam
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_MINUTES=10080

# Required for AI features
GROQ_API_KEY=

# Optional (enable when needed)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# SMTP (email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Kovidam AI Interviews
SMTP_USE_TLS=true

# Object storage (optional for local; required for production recordings/files)
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional observability
SENTRY_DSN=
